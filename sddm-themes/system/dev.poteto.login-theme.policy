<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>poteto</vendor>

  <action id="dev.poteto.login-theme">
    <description>Change the login screen theme</description>
    <message>Authentication is required to change the login screen theme</message>
    <icon_name>preferences-desktop-theme</icon_name>
    <!-- Ask for the admin password every time: auth_admin, not auth_admin_keep,
         so a successful switch never leaves a few minutes of free root behind. -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/poteto-login-theme</annotate>
  </action>
</policyconfig>
