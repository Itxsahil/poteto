#!/usr/bin/env python3
"""Set the desktop's accent color, the way macOS does it: one color for menu hovers,
selections, focus rings and buttons, everywhere that can take one.

    apply-accent <#rrggbb>    use this color
    apply-accent ""           back to each app's and theme's own

- The system preference (org.gnome.desktop.interface accent-color): only nine named colors
  exist there, so it gets the closest one. Apps reading the desktop portal (libadwaita, Qt
  through QT_QPA_PLATFORMTHEME=xdgdesktopportal) follow it live: xdg-desktop-portal-gnome
  passes it on (~/.config/xdg-desktop-portal/hyprland-portals.conf).
- GTK 4 / libadwaita: one of the nine named colors comes from the portal, live, so gtk.css is
  left alone (it would pin the color and stop the live change). A custom color, which the
  portal can only approximate, goes into ~/.config/gtk-4.0/gtk.css exactly, read when apps
  start.
- GTK 3 (Firefox's menus too) has no live accent, so it always gets the exact color through
  ~/.config/gtk-3.0/gtk.css, read when apps start.
- VS Code gets it through workbench.colorCustomizations, which it applies live. What was
  there before is kept aside and put back when the accent goes back to the default.
- Firefox gets it through poteto-accent.css in the chrome/ folder of each profile that uses
  this repo's firefox/userChrome.css, which imports it (Firefox reads it when it starts; it
  ignores the GTK accent). Without the file, Firefox keeps its own accent.

Only a marked block of each gtk.css is ever touched, so anything else in them stays.
"""

import fcntl
import json
import re
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
GTK3 = HOME / ".config/gtk-3.0/gtk.css"
GTK4 = HOME / ".config/gtk-4.0/gtk.css"
VSCODE = HOME / ".config/Code/User/settings.json"
VSCODE_BACKUP = HOME / ".cache/quickshell/accent-vscode-backup.json"
VSCODE_LOCK = HOME / ".cache/quickshell/vscode-settings.lock"
# The system accent as it was before this script first set one, so the default can put it back.
# Its existence is what says this script owns the current value.
SYSTEM_BACKUP = HOME / ".cache/quickshell/accent-system-backup.json"
FIREFOX_ROOTS = (HOME / ".config/mozilla/firefox", HOME / ".mozilla/firefox")
# This repo's Firefox stylesheet, which a profile has to link to for the accent file to matter
FIREFOX_CHROME = Path(__file__).resolve().parent.parent.parent / "firefox" / "userChrome.css"

BEGIN = "/* poteto accent: written by quickshellv2/scripts/apply-accent, edits here are replaced */"
END = "/* poteto accent end */"

# GNOME's named accent colors, as libadwaita draws them
NAMED = {
    "blue": "#3584e4", "teal": "#2190a4", "green": "#3a944a", "yellow": "#c88800",
    "orange": "#ed5b00", "red": "#e62d42", "pink": "#d56199", "purple": "#9141ac",
    "slate": "#6f8396",
}

# The VS Code colors that carry the accent: menu hover, selection, focus, buttons, badges
VSCODE_KEYS = {
    # Menu hover: recent VS Code (1.142) draws it with the list hover colors, which also color
    # hovering rows in the explorer and other lists; older ones used menu.selection*
    "list.hoverBackground": "accent",
    "list.hoverForeground": "fg",
    "menu.selectionBackground": "accent",
    "menu.selectionForeground": "fg",
    "list.activeSelectionBackground": "accent",
    "list.activeSelectionForeground": "fg",
    "quickInputList.focusBackground": "accent",
    "quickInputList.focusForeground": "fg",
    "focusBorder": "accent",
    "button.background": "accent",
    "button.foreground": "fg",
    "button.hoverBackground": "hover",
    "progressBar.background": "accent",
    "textLink.foreground": "accent",
    "activityBar.activeBorder": "accent",
    "activityBarBadge.background": "accent",
    "activityBarBadge.foreground": "fg",
    "tab.activeBorderTop": "accent",
    "inputOption.activeBorder": "accent",
    "checkbox.background": "accent",
    "checkbox.foreground": "fg",
}


def rgb(hex_color):
    h = hex_color.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexify(r, g, b):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in (r, g, b))


def foreground(hex_color):
    """Text drawn on the accent: dark on light colors, white on the rest."""
    def lin(c):
        c /= 255
        return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (lin(c) for c in rgb(hex_color))
    return "#1a1a1a" if 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.45 else "#ffffff"


def hover(hex_color):
    """A touch lighter, for hovering a button already drawn in the accent."""
    return hexify(*(c + (255 - c) * 0.15 for c in rgb(hex_color)))


def closest_named(hex_color):
    r, g, b = rgb(hex_color)
    return min(NAMED, key=lambda n: sum((a - c) ** 2 for a, c in zip((r, g, b), rgb(NAMED[n]))))


def write_block(path, block):
    """Put block between the markers in path (or remove it when block is None)."""
    old = path.read_text() if path.exists() else ""
    text = old
    pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n?", re.S)
    text = pattern.sub("", text).rstrip("\n")
    if block:
        text = (text + "\n\n" if text else "") + BEGIN + "\n" + block.strip("\n") + "\n" + END
    new = text + "\n" if text else ""
    if new != old and (new or path.exists()):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(new)


def gtk4_block(accent, fg):
    return f"""
@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {fg};
:root {{
    --accent-color: {accent};
    --accent-bg-color: {accent};
    --accent-fg-color: {fg};
}}
"""


def gtk3_block(accent, fg):
    return f"""
@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {fg};
@define-color theme_selected_bg_color {accent};
@define-color theme_selected_fg_color {fg};
selection, *:selected, row:selected, treeview.view:selected,
menu menuitem:hover, .menu menuitem:hover, menubar > menuitem:hover, popover modelbutton:hover {{
    background-color: {accent};
    color: {fg};
}}
"""


def vscode(accent):
    if not VSCODE.exists():
        return
    # scripts/apply-theme edits the same file
    VSCODE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(VSCODE_LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        vscode_locked(accent)


def vscode_locked(accent):
    try:
        raw = VSCODE.read_text()
        settings = json.loads(raw)
    except (OSError, ValueError):
        # Comments or trailing commas: not plain JSON, so leave it alone rather than mangle it
        print("apply-accent: VS Code settings.json is not plain JSON, skipped", file=sys.stderr)
        return
    custom = dict(settings.get("workbench.colorCustomizations") or {})

    if accent:
        if not VSCODE_BACKUP.exists():
            VSCODE_BACKUP.parent.mkdir(parents=True, exist_ok=True)
            VSCODE_BACKUP.write_text(json.dumps({k: custom[k] for k in VSCODE_KEYS if k in custom}))
        values = {"accent": accent, "fg": foreground(accent), "hover": hover(accent)}
        for key, kind in VSCODE_KEYS.items():
            custom[key] = values[kind]
    else:
        # The backup is the record that these colors are ours. Without it, this script never
        # changed anything (or it has already been undone), so whatever is there is the user's
        # own and stays: the shell runs this at every start.
        if not VSCODE_BACKUP.exists():
            return
        backup = {}
        try:
            backup = json.loads(VSCODE_BACKUP.read_text())
        except ValueError:
            pass
        VSCODE_BACKUP.unlink()
        for key in VSCODE_KEYS:
            custom.pop(key, None)
        custom.update(backup)

    before = json.dumps(settings, sort_keys=True)
    if custom:
        settings["workbench.colorCustomizations"] = custom
    else:
        settings.pop("workbench.colorCustomizations", None)
    # The shell runs this at every start: leave the file be when nothing changes
    if json.dumps(settings, sort_keys=True) == before:
        return
    indent = re.search(r"\n([ \t]+)\"", raw)
    VSCODE.write_text(json.dumps(settings, indent=indent.group(1) if indent else 4, ensure_ascii=False) + "\n")


def gsettings_accent():
    out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "accent-color"],
                         capture_output=True, text=True)
    return out.stdout.strip().strip("'") if out.returncode == 0 else ""


def default_accent():
    """The schema's own default for accent-color (what a reset gives), or "" if unknown."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        source = Gio.SettingsSchemaSource.get_default()
        schema = source.lookup("org.gnome.desktop.interface", True) if source else None
        if schema and schema.has_key("accent-color"):
            return schema.get_key("accent-color").get_default_value().get_string()
    except (ImportError, ValueError):
        pass
    return ""


def run_gsettings(*args):
    """Run gsettings; say why on stderr and return False if it failed."""
    out = subprocess.run(["gsettings", *args], capture_output=True, text=True)
    if out.returncode != 0:
        print(f"apply-accent: gsettings {' '.join(args)} failed: {out.stderr.strip()}", file=sys.stderr)
    return out.returncode == 0


def system_accent(accent):
    """The named system accent: set the closest one, or put back what was there before.
    Returns False if gsettings failed (the record of the old value is then kept for next time)."""
    if accent:
        # Remember the value from before the first time, not from before every change
        if not SYSTEM_BACKUP.exists():
            SYSTEM_BACKUP.parent.mkdir(parents=True, exist_ok=True)
            SYSTEM_BACKUP.write_text(json.dumps({"accent-color": gsettings_accent()}))
        name = closest_named(accent)
        if gsettings_accent() != name:
            return run_gsettings("set", "org.gnome.desktop.interface", "accent-color", name)
        return True
    # Not ours (never set, or already put back): a value chosen elsewhere stays
    if not SYSTEM_BACKUP.exists():
        return True
    try:
        previous = json.loads(SYSTEM_BACKUP.read_text()).get("accent-color", "")
    except ValueError:
        previous = ""
    if previous in NAMED:
        expected = previous
        ok = run_gsettings("set", "org.gnome.desktop.interface", "accent-color", previous)
    else:
        expected = default_accent()
        ok = run_gsettings("reset", "org.gnome.desktop.interface", "accent-color")
    # gsettings can exit 0 without saving anything (no session bus, say), so read the value
    # back from a fresh process before trusting it. Only forget the old value once it is really
    # back; otherwise keep it, and the next run tries again.
    if ok:
        actual = gsettings_accent()
        if not expected or actual != expected:
            print(f"apply-accent: accent-color is '{actual}' after restoring, expected "
                  f"'{expected or 'the default'}'; keeping the backup to try again",
                  file=sys.stderr)
            ok = False
    if ok:
        SYSTEM_BACKUP.unlink()
    return ok


def firefox(accent):
    """Write the accent for every Firefox profile that uses this repo's userChrome.css."""
    for root in FIREFOX_ROOTS:
        if not root.is_dir():
            continue
        for chrome in root.glob("*/chrome"):
            style = chrome / "userChrome.css"
            try:
                if not style.exists() or style.resolve() != FIREFOX_CHROME:
                    continue
            except OSError:
                continue
            target = chrome / "poteto-accent.css"
            if accent:
                text = ("/* written by quickshellv2/scripts/apply-accent */\n"
                        f":root {{ --poteto-accent-color: {accent}; "
                        f"--poteto-accent-color-text: {foreground(accent)}; }}\n")
                if not target.exists() or target.read_text() != text:
                    target.write_text(text)
            elif target.exists():
                target.unlink()


def main():
    if len(sys.argv) != 2 or (sys.argv[1] and not re.fullmatch(r"#[0-9a-fA-F]{6}", sys.argv[1])):
        print('usage: apply-accent <#rrggbb | "">', file=sys.stderr)
        return 2
    accent = sys.argv[1].lower()

    if accent:
        fg = foreground(accent)
        # Named colors reach libadwaita live through the portal; only a custom one is pinned here
        write_block(GTK4, None if accent in NAMED.values() else gtk4_block(accent, fg))
        write_block(GTK3, gtk3_block(accent, fg))
    else:
        write_block(GTK4, None)
        write_block(GTK3, None)
    system_ok = system_accent(accent)
    vscode(accent)
    firefox(accent)
    # Everything else is applied either way; a non-zero exit gets the failure into the shell's log
    return 0 if system_ok else 1


if __name__ == "__main__":
    sys.exit(main())
