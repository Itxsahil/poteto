# https://editorconfig.org — matches what the files already use

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[refrences/**]
# Someone else's code, kept as it is
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
