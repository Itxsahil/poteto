#!/usr/bin/env python3
"""Poteto: settings for the v2 shell (quickshellv2/).

Reads and writes ~/.config/poteto/shell.json, the file quickshellv2/config/Config.qml watches,
so every change shows up in the shell straight away, with no restart. The app watches the file
too, so a change made elsewhere (qs ipc call layout toggle, a hand edit) shows up here.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "dev.poteto.Settings"
CONFIG = Path(GLib.get_user_config_dir()) / "poteto" / "shell.json"
STYLES = ("pill", "bar")
MODES = ("dark", "light")
# Night light warmth in kelvin: the range the shell accepts, the slider's, and the default
NIGHT_MIN, NIGHT_MAX = 1000, 6500
SLIDER_MIN = 2000
NIGHT_DEFAULT = 4000
# Sends sample notifications (tools/notif-test in this repo), found through the real path of this
# script, which ~/.local/bin links to
NOTIF_TEST = Path(__file__).resolve().parent.parent / "tools" / "notif-test"
# Its cases, in the order they are listed: (case, title, what it shows)
NOTIF_CASES = (
    ("plain", "Plain", "No icon, no buttons, one line"),
    ("chrome", "Browser message", "A site's picture with the browser's badge on it"),
    ("badge", "Picture, no badge", "An image but no app icon"),
    ("actions", "With buttons", "Action buttons under the text"),
    ("critical", "Critical", "Urgent: red, and shown even in quiet mode"),
    ("long", "Long text", "A title and body that need trimming"),
    ("newlines", "Several lines", "Line breaks in the body"),
    ("url", "Link", "A bare web address that becomes clickable"),
    ("markup", "Formatting", "Bold, italic, underline and a link"),
    ("entities", "Special characters", "&, < and > that have to survive"),
)

# Accent swatches: GNOME's named accent colors, the ones apps that follow the system can match
# exactly. Any other color comes from the Custom picker.
SWATCHES = (
    ("blue", "#3584e4"), ("teal", "#2190a4"), ("green", "#3a944a"), ("yellow", "#c88800"),
    ("orange", "#ed5b00"), ("red", "#e62d42"), ("pink", "#d56199"), ("purple", "#9141ac"),
    ("slate", "#6f8396"),
)


def load():
    """The settings, or {} when the file is missing or unreadable; the shell has defaults."""
    try:
        data = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save(data):
    # Written in place rather than swapped in with a rename, so the shell's file watch keeps
    # following the same file. The shell keeps its last good settings if it reads mid-write.
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(data, indent=2) + "\n")


def current_style(data):
    return data.get("style") if data.get("style") in STYLES else "pill"


def current_mode(data):
    return data.get("mode") if data.get("mode") in MODES else "dark"


def current_accent(data):
    """The accent as #rrggbb, or "" for the theme's own."""
    value = data.get("accent")
    return value.lower() if isinstance(value, str) and re.fullmatch(r"#[0-9a-fA-F]{6}", value) else ""


def hex_of(rgba):
    return "#%02x%02x%02x" % tuple(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue))


def current_temperature(data):
    value = data.get("nightTemperature")
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return NIGHT_DEFAULT
    return max(NIGHT_MIN, min(NIGHT_MAX, round(value)))


class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Poteto")
        self.set_default_size(560, 600)
        # True while the window itself is updating a control, so that does not write back
        self._syncing = False

        page = Adw.PreferencesPage()

        appearance = Adw.PreferencesGroup(title="Appearance")
        page.add(appearance)

        self.style_toggle = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        self.style_toggle.add(Adw.Toggle(name="pill", label="Pill"))
        self.style_toggle.add(Adw.Toggle(name="bar", label="Bar"))
        self.style_toggle.connect("notify::active-name", self._on_changed, "style")

        row = Adw.ActionRow(
            title="Layout",
            subtitle="A floating pill at the top center, or a bar across the whole top",
        )
        row.add_suffix(self.style_toggle)
        appearance.add(row)

        self.mode_toggle = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
        self.mode_toggle.add(Adw.Toggle(name="light", icon_name="weather-clear-symbolic", tooltip="Light"))
        self.mode_toggle.add(Adw.Toggle(name="dark", icon_name="weather-clear-night-symbolic", tooltip="Dark"))
        self.mode_toggle.connect("notify::active-name", self._on_changed, "mode")

        row = Adw.ActionRow(
            title="Mode",
            subtitle="Light or dark, for the shell and every app that follows the system setting",
        )
        row.add_suffix(self.mode_toggle)
        appearance.add(row)

        # Accent: a swatch for the theme's own, one per named color, and Custom for any other
        self.swatches = {}
        swatch_box = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER, margin_top=6, margin_bottom=6)
        for name, color in (("default", ""),) + SWATCHES:
            button = Gtk.ToggleButton(tooltip_text="Theme default" if name == "default" else name.title())
            button.add_css_class("accent-swatch")
            button.add_css_class(f"swatch-{name}")
            button.set_child(Gtk.Image(icon_name="object-select-symbolic"))
            button.connect("toggled", self._on_swatch_toggled, color)
            if self.swatches:
                button.set_group(next(iter(self.swatches.values())))
            self.swatches[color] = button
            swatch_box.append(button)

        self.accent_picker = Gtk.ColorDialogButton(
            dialog=Gtk.ColorDialog(title="Accent Color", with_alpha=False),
            valign=Gtk.Align.CENTER,
            tooltip_text="Any color",
        )
        self.accent_picker.connect("notify::rgba", self._on_accent_picked)

        row = Adw.ActionRow(
            title="Accent Color",
            subtitle="Menus, selections and buttons in the shell, GTK, Qt and VS Code",
        )
        row.add_suffix(self.accent_picker)
        appearance.add(row)

        swatch_row = Adw.PreferencesRow(activatable=False)
        swatch_row.set_child(swatch_box)
        swatch_box.set_halign(Gtk.Align.CENTER)
        appearance.add(swatch_row)

        night = Adw.PreferencesGroup(title="Night Light")
        page.add(night)

        self.night_switch = Adw.SwitchRow(
            title="Night Light",
            subtitle="Warmer colors, easier on the eyes at night",
        )
        self.night_switch.connect("notify::active", self._on_night_changed)
        night.add(self.night_switch)

        # Right is warmer, which means fewer kelvin. The scale itself runs forwards, so it fills
        # from the left as it warms, and its position is turned into kelvin (see _warmth)
        self.warmth = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, SLIDER_MIN, NIGHT_MAX, 100)
        self.warmth.set_draw_value(False)
        self.warmth.set_hexpand(True)
        self.warmth.set_size_request(220, -1)
        self.warmth.set_valign(Gtk.Align.CENTER)
        self.warmth.connect("value-changed", self._on_warmth_changed)

        self.warmth_row = Adw.ActionRow(title="Warmth")
        self.warmth_row.add_prefix(Gtk.Image(icon_name="weather-clear-symbolic"))
        self.warmth_row.add_suffix(self.warmth)
        night.add(self.warmth_row)
        # Dragging writes the file once it pauses, not on every step
        self._warmth_write = 0

        notifications = Adw.PreferencesGroup(title="Notifications")
        page.add(notifications)

        self.quiet_switch = Adw.SwitchRow(
            title="Quiet Mode",
            subtitle="Notifications go straight to history; critical ones still show",
        )
        self.quiet_switch.connect("notify::active", self._on_quiet_changed)
        notifications.add(self.quiet_switch)

        tests = Adw.ExpanderRow(
            title="Send a Test Notification",
            subtitle="See how each kind looks in the pill",
        )
        send_all = Gtk.Button(label="Send all", valign=Gtk.Align.CENTER)
        send_all.add_css_class("flat")
        send_all.set_tooltip_text("Every kind, a few seconds apart")
        send_all.connect("clicked", self._on_send_test, None)
        tests.add_suffix(send_all)
        for case, title, what in NOTIF_CASES:
            row = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(what))
            send = Gtk.Button(icon_name="mail-send-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Send")
            send.add_css_class("flat")
            send.connect("clicked", self._on_send_test, case)
            row.add_suffix(send)
            row.set_activatable_widget(send)
            tests.add_row(row)
        if not NOTIF_TEST.exists():
            tests.set_sensitive(False)
            tests.set_subtitle(f"{NOTIF_TEST} is missing")
        notifications.add(tests)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(page)
        self.set_content(toolbar)

        self._monitor = Gio.File.new_for_path(str(CONFIG)).monitor_file(Gio.FileMonitorFlags.NONE, None)
        self._monitor.connect("changed", self._on_file_changed)

        self._sync_from_file()

    def _sync_from_file(self):
        data = load()
        self._syncing = True
        for toggle, value in ((self.style_toggle, current_style(data)), (self.mode_toggle, current_mode(data))):
            if toggle.get_active_name() != value:
                toggle.set_active_name(value)
        accent = current_accent(data)
        # A named color or the default lights its swatch; a custom one lights none
        for color, button in self.swatches.items():
            button.set_active(color == accent)
        if accent and hex_of(self.accent_picker.get_rgba()) != accent:
            rgba = Gdk.RGBA()
            rgba.parse(accent)
            self.accent_picker.set_rgba(rgba)
        quiet = data.get("quiet") is True
        if self.quiet_switch.get_active() != quiet:
            self.quiet_switch.set_active(quiet)
        night = data.get("nightLight") is True
        if self.night_switch.get_active() != night:
            self.night_switch.set_active(night)
        # Not while a drag is still waiting to be written, or the slider would jump back
        if not self._warmth_write:
            temperature = current_temperature(data)
            if self._warmth() != temperature:
                self.warmth.set_value(NIGHT_MAX + SLIDER_MIN - temperature)
            self._show_warmth(temperature)
        self._syncing = False

    def _set(self, key, value):
        data = load()
        if data.get(key) == value:
            return
        data[key] = value
        save(data)

    def _on_changed(self, toggle, _pspec, key):
        if not self._syncing:
            self._set(key, toggle.get_active_name())

    def _on_swatch_toggled(self, button, color):
        if not self._syncing and button.get_active():
            self._set("accent", color)

    def _on_accent_picked(self, picker, _pspec):
        if not self._syncing:
            self._set("accent", hex_of(picker.get_rgba()))

    def _on_quiet_changed(self, row, _pspec):
        if not self._syncing:
            self._set("quiet", row.get_active())

    def _on_send_test(self, _button, case):
        # In the background: one waits for its buttons to be clicked, and "all" takes a while
        subprocess.Popen([str(NOTIF_TEST)] + ([case] if case else []),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def _on_night_changed(self, row, _pspec):
        if not self._syncing:
            self._set("nightLight", row.get_active())

    def _show_warmth(self, temperature):
        self.warmth_row.set_subtitle(f"{temperature} K, lower is warmer")

    def _warmth(self):
        """The slider's position in kelvin: left is NIGHT_MAX, right is SLIDER_MIN. A drag lands
        anywhere, so this keeps to steps of 100 K."""
        return round((NIGHT_MAX + SLIDER_MIN - self.warmth.get_value()) / 100) * 100

    def _on_warmth_changed(self, scale):
        self._show_warmth(self._warmth())
        if self._syncing:
            return
        if self._warmth_write:
            GLib.source_remove(self._warmth_write)
        self._warmth_write = GLib.timeout_add(150, self._write_warmth)

    def _write_warmth(self):
        self._warmth_write = 0
        self._set("nightTemperature", self._warmth())
        return GLib.SOURCE_REMOVE

    def _on_file_changed(self, _monitor, _file, _other, event):
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                     Gio.FileMonitorEvent.DELETED):
            self._sync_from_file()


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_startup(self):
        Adw.Application.do_startup(self)
        # The icon from settings/dev.poteto.Settings.svg, installed into the user icon theme
        Gtk.Window.set_default_icon_name(APP_ID)

        # Round swatches in their own colors; the check only shows on the chosen one
        css = """
        .accent-swatch { min-width: 26px; min-height: 26px; padding: 0; border-radius: 999px;
                         box-shadow: inset 0 0 0 1px alpha(black, 0.15); }
        .accent-swatch image { opacity: 0; color: white; }
        .accent-swatch:checked image { opacity: 1; }
        .accent-swatch:checked { outline: 2px solid alpha(currentColor, 0.6); outline-offset: 2px; }
        .swatch-default { background: linear-gradient(135deg, #8a8f98 50%, #d8dade 50%); }
        """ + "".join(f".swatch-{name} {{ background: {color}; }}\n" for name, color in SWATCHES)
        provider = Gtk.CssProvider()
        provider.load_from_string(css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        window = self.get_active_window() or SettingsWindow(self)
        window.present()


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
