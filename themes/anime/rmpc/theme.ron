#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// Anime: Eldritch colors to match the kitty theme, and no background anywhere (background,
// header and progress track are left unset) so the see-through terminal shows through.
(
    default_album_art_path: None,
    draw_borders: false,
    show_song_table_header: false,
    symbols: (song: "🎵", dir: "📁", playlist: "🎼", marker: "\u{e0b0}"),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "1",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    progress_bar: (
        symbols: ["-", "-", ">", " ", " "],
        track_style: (fg: "#323449"),
        elapsed_style: (fg: "#37f499"),
        thumb_style: (fg: "#37f499"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#37f499"),
    ),
    browser_column_widths: [20, 38, 42],
    text_color: "#ebfafa",
    background_color: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    tab_bar: (active_style: (fg: "#212337", bg: "#37f499", modifiers: "Bold"), inactive_style: ()),
    borders_style: (fg: "#7081d0"),
    highlighted_item_style: (fg: "#37f499", modifiers: "Bold"),
    current_item_style: (fg: "#212337", bg: "#a48cf2", modifiers: "Bold"),
    highlight_border_style: (fg: "#a48cf2"),
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#a48cf2"), default: (kind: Text("Unknown"))),
            width: "50%",
            alignment: Right,
        ),
        (
            prop: (kind: Text("-"), style: (fg: "#7081d0"), default: (kind: Text("Unknown"))),
            width: "1",
            alignment: Center,
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#04d1f9"), default: (kind: Text("Unknown"))),
            width: "50%",
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "#37f499", modifiers: "Bold")),
                    (kind: Property(Status(State)), style: (fg: "#37f499", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "#37f499", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#f1fc79", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#f1fc79", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Title)), style: (fg: "#04d1f9", modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (fg: "#04d1f9", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#37f499", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#37f499", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#37f499", modifiers: "Bold"))
                ]
            )
        ],
    ),
)
